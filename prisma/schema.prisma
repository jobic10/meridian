generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECORDS_OFFICER
  PHARMACIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LabStatus {
  PENDING
  COMPLETED
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  email          String?
  passwordHash   String
  role           Role
  specialisation String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patientsRegistered   Patient[]        @relation("RegisteredBy")
  appointments         Appointment[]    @relation("DoctorAppointments")
  medicalRecords       MedicalRecord[]  @relation("DoctorRecords")
  dispensedPrescriptions Prescription[] @relation("DispensedBy")
  labResultsEntered    LabResult[]      @relation("EnteredBy")
  auditLogs            AuditLog[]

  @@index([role])
}

model Patient {
  id              String   @id @default(cuid())
  patientCode     String   @unique
  firstName       String
  lastName        String
  gender          String
  dateOfBirth     DateTime
  address         String?
  phone           String?
  nextOfKin       String?
  nextOfKinPhone  String?
  bloodGroup      String?
  allergies       String?
  registeredById  String?
  registeredBy    User?    @relation("RegisteredBy", fields: [registeredById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  labResults      LabResult[]

  @@index([lastName, firstName])
}

model Appointment {
  id                String            @id @default(cuid())
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id])
  doctorId          String
  doctor            User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  date              DateTime
  time              String
  reason            String?
  status            AppointmentStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([date, status])
  @@index([doctorId, date])
}

model MedicalRecord {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          User     @relation("DoctorRecords", fields: [doctorId], references: [id])
  visitDate       DateTime @default(now())
  symptoms        String
  diagnosis       String
  treatmentNotes  String?
  createdAt       DateTime @default(now())

  prescriptions   Prescription[]
  labResults      LabResult[]

  @@index([patientId, visitDate])
}

model Prescription {
  id              String    @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  drugName        String
  dosage          String
  duration        String
  dispensed       Boolean   @default(false)
  dispensedById   String?
  dispensedBy     User?     @relation("DispensedBy", fields: [dispensedById], references: [id])
  dispensedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([dispensed])
}

model LabResult {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  testName        String
  result          String?
  notes           String?
  status          LabStatus @default(PENDING)
  enteredById     String
  enteredBy       User      @relation("EnteredBy", fields: [enteredById], references: [id])
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
